<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
     <event name="sales_quote_save_after">
        <observer name="Aprilo_cashback_save_quote" instance="Aprilo\Cashback\Observer\SaveQuoteCashback" />
    </event>
     <event name="sales_model_service_quote_submit_before">
        <observer name="Aprilo_sales_convert_quote" instance="Aprilo\Cashback\Observer\SalesConvertQuote"/>
    </event>
    <!-- <event name="sales_order_save_after">
        <observer name="Aprilo_sales_order_save_after" instance="Aprilo\Cashback\Observer\OrderSaveAfter"/>
    </event> -->
    <!-- Event for order cancellation -->
    <event name="order_cancel_after">
        <observer name="Aprilo_cashback_order_cancel" instance="Aprilo\Cashback\Observer\OrderCancelAfter" />
    </event>
    <!-- Event for credit memo creation -->
    <event name="sales_order_creditmemo_save_after">
        <observer name="Aprilo_cashback_creditmemo_save" instance="Aprilo\Cashback\Observer\CreditmemoSaveAfter" />
    </event>
    <!-- Event for create invoice  -->
    <event name="sales_order_invoice_register">
        <observer name="save_order_data_to_invoice" instance="Aprilo\Cashback\Observer\SaveOrderDataToInvoice" />
    </event>
</config>
